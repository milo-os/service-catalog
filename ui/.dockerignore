# Tests and E2E assets: not part of the runtime image
e2e
playwright.config.ts
playwright.demo.config.ts
playwright-report
test-results

# Local env / secrets
.env
.env.*

# VCS, docs, tooling
.git
*.md
Taskfile.yaml
.cache
*.log
